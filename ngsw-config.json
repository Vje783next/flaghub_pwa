{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ],
        "urls":["https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ], 
  "dataGroups": [
    {
      "name": "flagshub-api",
      "urls": ["https://restcountries.com/v3.1/all?fields=name,flags,cca3,capital,region,subregion,population,languages,currencies,maps"],
      "cacheConfig": {
        "maxSize": 100,
        "maxAge": "1h",
        "timeout": "2s",
        "strategy": "freshness"
      }
    }
  ]
}
